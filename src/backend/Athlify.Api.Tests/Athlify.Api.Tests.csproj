<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.14" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.13" />
		<PackageReference Include="TUnit" Version="1.76.0" />
		<PackageReference Include="TUnit.AspNetCore" Version="1.76.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Athlify.Api\Athlify.Api.csproj" />
	</ItemGroup>

	<ItemGroup>
	  <None Update="AuthEndpoints\Expired\appsettings.json">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </None>
	  <None Update="AuthEndpoints\Logout\appsettings.json">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </None>
	  <None Update="AuthEndpoints\Misc\appsettings.json">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </None>
	  <None Update="AuthEndpoints\Reuse\appsettings.json">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </None>
	</ItemGroup>

</Project>
