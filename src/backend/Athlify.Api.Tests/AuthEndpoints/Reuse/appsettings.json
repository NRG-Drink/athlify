{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Database": {
    "AutoMigrate":  false
  },
  "Jwt": {
    "Issuer": "NRG.Api",
    "Audience": "NRG.Api.Client",
    "SigningKey": "development-only-signing-key-change-this-32-bytes",
    "LifetimeMinutes": 10,
    "RefreshTokenLifetimeDays": 7,
    "ClockSkewSeconds": 1
  },
  "AllowedHosts": "*"
}
