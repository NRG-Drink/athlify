<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<LangVersion>preview</LangVersion>
		<ContainerRepository>athlify</ContainerRepository>
	</PropertyGroup>

	<ItemGroup Condition="'$(ImplicitUsings)' == 'enable'">
		<Using Include="Athlify.Api" />
		<!-- HotChocolate.Types (a global using of Hot Chocolate) also has a Tag type. -->
		<Using Include="Athlify.Api.Domain.Tags.Tag" Alias="Tag" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Aspire.Npgsql.EntityFrameworkCore.PostgreSQL" Version="13.6.2" />
		<PackageReference Include="GreenDonut.Data.EntityFramework" Version="16.6.9" />
		<PackageReference Include="HotChocolate.AspNetCore" Version="16.6.9" />
		<PackageReference Include="HotChocolate.AspNetCore.CommandLine" Version="16.6.9" />
		<PackageReference Include="HotChocolate.Data" Version="16.6.9" />
		<PackageReference Include="HotChocolate.Types.Analyzers" Version="16.6.9">
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13">
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.13" />
	</ItemGroup>

	<ItemGroup>
		<Folder Include="Database\Migrations\" />
	</ItemGroup>

</Project>
