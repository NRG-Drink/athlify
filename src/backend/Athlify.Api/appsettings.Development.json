{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Database": {
    "AutoMigrate":  true
  },
  "ConnectionStrings": {
    "postgres-db": "Host=localhost;Database=athlify;Username=postgres;Password=postgres"
  },
  "Jwt": {
    "Issuer": "Athlify.Api",
    "Audience": "Athlify.Webclient",
    "SigningKey": "development-only-signing-key-change-this-32-bytes",
    "LifetimeMinutes": 15,
    "RefreshTokenLifetimeDays": 7,
    "ClockSkewSeconds": 1
  },
  "Athlify": {
    "Seed": {
      "Enabled": true
    }
  }
}
