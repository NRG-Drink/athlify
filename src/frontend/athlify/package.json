{
  "name": "athlify",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc -b --noEmit",
    "preview": "vite preview",
    "relay": "relay-compiler",
    "relay:watch": "relay-compiler --watch",
    "schema:export": "node scripts/export-schema.mjs",
    "schema:download": "curl -o schema.graphql http://localhost:5095/graphql?sdl"
  },
  "dependencies": {
    "@chakra-ui/charts": "^3.37.0",
    "@chakra-ui/react": "^3.37.0",
    "@emotion/react": "^11.14.0",
    "@tailwindcss/vite": "^4.3.3",
    "i18next": "^26.4.2",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.14",
    "react-icons": "^5.7.0",
    "react-relay": "^21.0.1",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "relay-runtime": "^21.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rolldown/plugin-babel": "^0.2.4",
    "@types/node": "^22.20.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/relay-runtime": "^20.1.1",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-plugin-relay": "^21.0.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "graphql": "^17.0.2",
    "prettier": "^3.9.7",
    "relay-compiler": "^21.0.1",
    "vite": "^8.3.0",
    "vite-plugin-relay": "^2.1.0"
  }
}
