{
  "name": "Athlify",
  "image": "mcr.microsoft.com/devcontainers/dotnet:dev-10.0",
  "features": {
    // Aspire starts PostgreSQL as a container, so the container needs the host's Docker.
    // moby:false uses Docker CE packages; the Moby packages are unavailable on newer Debian bases.
    // "ghcr.io/devcontainers/features/docker-outside-of-docker:1": { "moby": false },
    "ghcr.io/devcontainers/features/docker-in-docker": {},
    "ghcr.io/devcontainers/features/vite-plus": {},
    "ghcr.io/dotnet/aspire-devcontainer-feature/dotnetaspire:1": {},
    "ghcr.io/devcontainers/features/node:2.1.0": {},
    "ghcr.io/devcontainers/features/dotnet:2": {
      "version": "8.0",
      "aspNetCoreRuntimeVersions": "8.0"
    }
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csdevkit",
        "ms-dotnettools.csharp",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss",
        "GraphQL.vscode-graphql",
        "meta.relay"
      ],
      "settings": {
				"remote.autoForwardPorts": true,
 				"remote.autoForwardPortsSource": "hybrid",
				"remote.otherPortsAttributes": {
					"onAutoForward": "ignore"
				},
				"dotnet.defaultSolution": "disable"
      }
    }
  }
}
