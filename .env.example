# Copy this file to .env and replace the password before starting Compose.
POSTGRES_DB=athlify
POSTGRES_USER=athlify
POSTGRES_PASSWORD=

# The app service is the only published application port.
WEB_PORT=8080

# Optional development-user identity used until authentication is implemented.
ATHLIFY_DEVELOPMENT_USER_EMAIL=admin@athlify.local
ATHLIFY_DEVELOPMENT_USER_FIRST_NAME=Athlify
ATHLIFY_DEVELOPMENT_USER_LAST_NAME=Admin

# Writes sample Body-Stats and Activities for the development user at startup.
# Keep false for real data; only enable for a demo instance.
ATHLIFY_SEED_ENABLED=false
